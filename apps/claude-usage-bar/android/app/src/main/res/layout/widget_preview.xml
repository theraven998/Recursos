<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="9dp"
    android:paddingEnd="16dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:id="@+id/row_semana"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="SEMANA"
            android:textColor="#8A8A8A"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/bar_semana"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/prev_bar_a" />

        <TextView
            android:id="@+id/pct_semana"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="41%"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_claude"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.08"
            android:text="CLAUDE"
            android:textColor="#8A8A8A"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/bar_claude"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:src="@drawable/prev_bar_b" />

        <TextView
            android:id="@+id/pct_claude"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/doto"
            android:gravity="end"
            android:includeFontPadding="false"
            android:text="55%"
            android:textColor="#FFB000"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/red_dot" />

        <TextView
            android:id="@+id/line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="+14 pts · reinicia vie 12:00 PM · en 3 d 21 h"
            android:textColor="#8A8A8A"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/act"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:includeFontPadding="false"
            android:text="act. 9:15"
            android:textColor="#5C5C5C"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
